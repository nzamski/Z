NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=postgres://z:z@localhost:5433/z
TEST_DATABASE_URL=postgres://z:z@localhost:5433/z_test
OIDC_ISSUER=http://localhost:8180/realms/z
OIDC_CLIENT_ID=z
OIDC_CLIENT_SECRET=dev-secret-not-for-prod
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
SESSION_MAX_AGE_HOURS=12
APP_URL=http://localhost:3000
# keycloak (default) or dev (user switcher at /dev/login; refused in production)
AUTH_PROVIDER=keycloak

# "Message privately" deep link into the operational chat; {handle} is replaced. Unset = no button.
CHAT_DEEPLINK_TEMPLATE=chat://user/{handle}

# For You candidate window in days (optional, default 30).
# FEED_WINDOW_DAYS=30
# Private CA for Postgres TLS (optional; use ?sslmode=verify-full in DATABASE_URL).
# DATABASE_CA_FILE=/etc/z/pg-ca.crt
